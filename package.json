{
  "name": "short-video-maker",
  "version": "1.3.4",
  "description": "Creates short videos for TikTok, Instagram Reels, and YouTube Shorts using the Model Context Protocol (MCP) and a REST API.",
  "main": "index.js",
  "bugs": "https://github.com/gyoridavid/short-video-maker/issues",
  "homepage": "https://github.com/gyoridavid/short-video-maker",
  "scripts": {
    "build": "rimraf dist && tsc --project tsconfig.build.json && vite build && node scripts/copy-edge-tts-script.js",
    "dev": "vite build --watch | node --watch -r ts-node/register src/index.ts ",
    "start": "node dist/index.js",
    "test": "vitest",
    "lint": "eslint src --ext .ts,.tsx",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "typecheck:ui": "tsc -p src/ui/tsconfig.json --noEmit",
    "verify:baseline": "npm run typecheck && npm exec vitest run",
    "verify:production": "npm run typecheck && npm exec vitest run && npm run build && npm run test:routes",
    "qa": "npm run qa:check && npm run qa:generate && npm run qa:check",
    "qa:check": "ts-node scripts/qa/check-ai-mistakes.ts && ts-node scripts/qa/check-test-existence.ts && ts-node scripts/qa/check-docs-consistency.ts",
    "qa:generate": "ts-node scripts/qa/generate-index.ts && ts-node scripts/qa/generate-docs.ts",
    "qa:typecheck": "tsc -p tsconfig.scripts.json --noEmit",
    "backup:data": "ts-node scripts/backupData.ts",
    "backup:full": "node scripts/backup.mjs",
    "backup:full:verify": "node scripts/backup.mjs --verify",
    "restore:full": "node scripts/restore.mjs",
    "prepublishOnly": "npm run build && echo \"#!/usr/bin/env node\n$(cat dist/index.js)\" > dist/index.js && chmod +x dist/index.js",
    "publish:docker": "npm run publish:docker:normal && npm run publish:docker:cuda && npm run publish:docker:tiny",
    "publish:docker:cuda": "docker buildx build --platform linux/amd64 -t gyoridavid/short-video-maker:latest-cuda -t gyoridavid/short-video-maker:${npm_package_version}-cuda -f main-cuda.Dockerfile --push ./",
    "publish:docker:normal": "docker buildx build --platform linux/amd64,linux/arm64 -t gyoridavid/short-video-maker:latest -t gyoridavid/short-video-maker:${npm_package_version} -f main.Dockerfile --push ./",
    "publish:docker:tiny": "docker buildx build --platform linux/amd64,linux/arm64 -t gyoridavid/short-video-maker:latest-tiny -t gyoridavid/short-video-maker:${npm_package_version}-tiny -f main-tiny.Dockerfile --push ./",
    "ui:dev": "vite",
    "ui:build": "vite build",
    "ui:preview": "vite preview",
    "db:migration:status": "node scripts/migrations/status.mjs",
    "db:migration:preflight": "node scripts/migrations/preflight.mjs",
    "db:migration:reconcile": "node scripts/migrations/reconcile.mjs",
    "db:migration:remediation-plan": "node scripts/migrations/remediation-plan.mjs",
    "db:migration:readiness": "node scripts/migrations/readiness.mjs",
    "db:migration:apply": "node scripts/migrations/apply.mjs",
    "storage:migration:apply": "node scripts/migrations/artifacts.mjs",
    "db:backup:create": "node scripts/migrations/backup.mjs",
    "db:backup:verify": "node scripts/migrations/backup.mjs --verify",
    "qa:two-tenant-acceptance": "node scripts/qa/two-tenant-acceptance.mjs",
    "db:migration:reconciliation-decision": "node scripts/migrations/reconciliation-decision.mjs",
    "db:migration:evidence": "node scripts/migrations/evidence.mjs",
    "test:routes": "ts-node scripts/qa/route-inventory.test.ts"
  },
  "bin": {
    "short-video-maker": "dist/index.js"
  },
  "files": [
    "dist",
    "static"
  ],
  "keywords": [
    "shorts",
    "mcp",
    "model context protocol",
    "reels",
    "tiktok",
    "youtube shorts",
    "youtube",
    "short video",
    "video creation",
    "instagram",
    "video",
    "generator",
    "remotion",
    "faceless video"
  ],
  "author": "David Gyori",
  "license": "MIT",
  "dependencies": {
    "@emotion/react": "^11.11.3",
    "@emotion/styled": "^11.11.0",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@modelcontextprotocol/sdk": "^1.9.0",
    "@mui/icons-material": "^5.15.10",
    "@mui/material": "^5.15.10",
    "@remotion/bundler": "^4.0.286",
    "@remotion/cli": "^4.0.286",
    "@remotion/google-fonts": "^4.0.286",
    "@remotion/install-whisper-cpp": "^4.0.286",
    "@remotion/renderer": "^4.0.286",
    "@remotion/zod-types": "^4.0.286",
    "@tanstack/react-query": "^5.18.0",
    "@types/form-data": "^2.5.2",
    "@types/react-dom": "^19.1.3",
    "@types/react-router-dom": "^5.3.3",
    "@types/uuid": "^11.0.0",
    "axios": "^1.9.0",
    "bullmq": "^5.71.1",
    "content-type": "^1.0.5",
    "cuid": "^3.0.0",
    "dotenv": "^16.4.7",
    "express": "^4.18.2",
    "express-rate-limit": "^8.3.1",
    "fluent-ffmpeg": "^2.1.3",
    "form-data": "^4.0.5",
    "fs-extra": "^11.3.0",
    "googleapis": "^171.4.0",
    "ioredis": "^5.10.1",
    "kokoro-js": "^1.2.0",
    "nock": "^14.0.3",
    "node-cron": "^4.2.1",
    "pino": "^9.6.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.5.3",
    "recharts": "^3.8.1",
    "remotion": "^4.0.286",
    "rss-parser": "^3.13.0",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^13.0.0",
    "zod": "^4.3.6",
    "zod-to-json-schema": "^3.24.5",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "^4.0.286",
    "@types/content-type": "^1.1.8",
    "@types/express": "^4.17.21",
    "@types/fluent-ffmpeg": "^2.1.27",
    "@types/fs-extra": "^11.0.4",
    "@types/nock": "^11.1.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.1.0",
    "@types/swagger-ui-express": "^4.1.8",
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.4.16",
    "eslint": "^9.24.0",
    "postcss": "^8.4.31",
    "prettier": "^3.5.3",
    "rimraf": "^6.0.1",
    "tailwindcss": "^3.3.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "vite": "^6.3.4",
    "vitest": "^3.1.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@ffmpeg-installer/linux-x64",
      "msgpackr-extract",
      "onnxruntime-node",
      "protobufjs",
      "sharp"
    ]
  }
}
